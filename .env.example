# Documentação das variáveis aceitas; carregue-as no ambiente antes de iniciar.
BORAOBRA_ENV=development
FLASK_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bora_obra
DB_USER=usuario_mysql
DB_PASSWORD=senha_mysql
DB_CHARSET=utf8mb4
FLASK_DEBUG=0
FLASK_COOKIE_SECURE=0
BORAOBRA_SESSION_MINUTES=480
BORAOBRA_SLOW_REQUEST_MS=1000
BORAOBRA_GEOCODING=1
BORAOBRA_GEOCODING_USER_AGENT=BoraObra/1.0 (contato: email@dominio.com)
# Opcional: caminho de Chrome, Edge ou Brave quando o Chromium do Playwright não estiver instalado.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
